    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uC544\uBB34\uB9AC \uBC14\uBCF4\uB77C\uB3C4 \uB3D9\uB8CC\uAC00 \uBC14\uB2E5\uC5D0
    \uC4F0\uB824\uC838 \uC788\uC73C\uBA74 \uB204\uAD70\uAC00\uAC00 \uD0C8\uCD9C\uD55C
    \uAC83\uC744 \uB208\uCE58\uCC4C \uAC81\uB2C8\uB2E4.\n\uC801\uC5B4\uB3C4 \uB2F9\uC2E0\uC774
    \uC644\uBCBD\uD788 \uAC10\uC625\uC744 \uD0C8\uCD9C\uD558\uAE30 \uC804\uAE4C\uC9C0\uB294
    \uAE30\uC808\uD55C \uC0AC\uB78C\uC744 \uC228\uACA8\uC57C\uACA0\uC8E0.\n\uAC10\uC625
    \uACF3\uACF3\uC5D0 \uC788\uB294 \uB4DC\uB7FC\uD1B5\uC774 \uB9C8\uCE68 \uC0AC\uB78C
    \uD55C \uBA85 \uB123\uAE30\uC5D0\uB294 \uB531 \uC88B\uC740 \uC0AC\uC774\uC988\uC77C
    \uAC83 \uAC19\uAD70\uC694.\n\n\uC2DC\uCCB4\uB97C \uB4E4\uACE0 \uC788\uB294 \uC0C1\uD0DC\uB85C
    \uB4DC\uB7FC\uD1B5\uAE4C\uC9C0 \uAC00\uC11C \uC0C1\uD638\uC791\uC6A9\uD558\uBA74
    \uB420 \uAC81\uB2C8\uB2E4."
