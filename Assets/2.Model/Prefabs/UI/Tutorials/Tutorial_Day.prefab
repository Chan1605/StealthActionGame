--- !u!114 &2379507301948624026
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7506135337370540026}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 100
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uC774 \uAC8C\uC784\uC740 \uAE30\uBCF8\uC801\uC73C\uB85C \uC774\uB3D9\uC744
    WASD\uB85C \uC870\uC791\uD558\uACE0,\n\uB9C8\uC6B0\uC2A4\uB85C \uD50C\uB808\uC774\uC5B4\uC758
    \uC2DC\uC57C\uC640 \uBC29\uD5A5\uC744 \uC870\uC808\uD569\uB2C8\uB2E4.\n\uC2A4\uD398\uC774\uC2A4
    \uBC14\uB97C \uB204\uB974\uBA74 \uC810\uD504\uB97C \uD558\uACE0, \n\uC67C\uCABD
    Shift \uD0A4\uB97C \uB204\uB974\uACE0 \uC788\uC73C\uBA74 \uB2EC\uB9AC\uAE30\uB97C
    \uD569\uB2C8\uB2E4.\n\uC67C\uCABD Ctrl\uD0A4\uB97C \uB20C\uB7EC \uB290\uB9AC\uC9C0\uB9CC
    \uC870\uC6A9\uD788 \uC774\uB3D9\uD558\uB294 \uBAA8\uB4DC\uB85C \uBC14\uAFB8\uB294
    \uAC83\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\n\uD558\uC774\uB77C\uC774\uD2B8\uB418\uB294
    \uC544\uC774\uD15C\uC5D0 E\uD0A4\uB97C \uB20C\uB7EC \uC0C1\uD638\uC791\uC6A9\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB9C8\uC9C0\uB9C9\uC73C\uB85C F\uB97C \uB204\uB974\uACE0
    \uC788\uC73C\uBA74 \uC801\uC758 \uC704\uCE58\uB97C \uD558\uC774\uB77C\uC774\uD2B8\uD558\uC5EC
    \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC774 \uBAA8\uB4E0 \uC870\uC791\uC740
    \uBA54\uB274\uC5D0\uC11C \uC7AC\uC124\uC815\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
