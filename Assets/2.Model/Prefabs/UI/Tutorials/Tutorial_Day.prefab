  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 6
    m_MaxSize: 60
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uBAA8\uB4E0 \uC801\uB4E4\uC740 \uB2F9\uC2E0\uC758 \uBC1C\uC790\uAD6D
    \uC18C\uB9AC\uB97C \uB4E4\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uADF8\uB807\uC9C0\uB9CC
    \uC801\uB4E4\uC758 \uB4E3\uB294 \uB2A5\uB825\uC744 \uC5ED\uC774\uC6A9\uD574 \uC801\uC744
    \uC720\uC778\uD558\uB294 \uAC83\uB3C4 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\uBCD1\uC744
    \uB358\uC838\uC11C \uAE68\uD2B8\uB9AC\uC11C \uC694\uB780\uD55C \uC18C\uB9AC\uB97C
    \uB0B4\uBA74 \uC801\uC740 \uADF8 \uC18C\uB9AC\uC5D0 \uC774\uB04C\uB9AC\uAC8C
    \uB429\uB2C8\uB2E4.\n\n\uBCD1\uC744 \uB4E4\uACE0 \uC788\uC744 \uB54C \uC67C\uCABD
    \uB9C8\uC6B0\uC2A4 \uD074\uB9AD\uC744 \uD558\uAC8C \uB418\uBA74 \uC870\uC900\uC744
    \uD558\uACE0, \n\uADF8 \uC0C1\uD0DC\uB85C \uD55C \uBC88 \uB354 \uD074\uB9AD\uD558\uBA74
    \uADF8 \uBC29\uD5A5\uC73C\uB85C \uBCD1\uC744 \uB358\uC9D1\uB2C8\uB2E4.\n\n\uAF2D
    \uBCD1\uC774 \uC544\uB2C8\uB354\uB77C\uB3C4 \uB2E4\uB978 \uBC29\uC2DD\uC73C\uB85C
    \uC694\uB780\uD55C \uC18C\uB9AC\uB97C \uB0B4\uB294 \uBB3C\uCCB4\uB3C4 \uD65C\uC6A9\uC774
    \uAC00\uB2A5\uD569\uB2C8\uB2E4."
